# Base URL of the application under test.
# Point this at a deploy-preview or staging URL in CI when testing a PR build.
BASE_URL=https://vranjan.dev

# Number of parallel workers. Leave unset to let Playwright decide (CPU count locally, 1 on CI unless overridden below).
# PW_WORKERS=4

# Set to "1" to record a HAR file per test for debugging network issues.
RECORD_HAR=0

# Set to "1" to update visual regression snapshots instead of comparing against them.
# Prefer `npm run test:visual:update` over setting this manually.
UPDATE_SNAPSHOTS=0
